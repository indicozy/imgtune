{
  "name": "imgtune",
  "version": "0.1.0",
  "description": "Measures images in a Next.js app and tunes next/image sizes and quality",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "next-image",
    "images",
    "srcset",
    "image-optimization",
    "ssimulacra2",
    "ssim",
    "performance"
  ],
  "repository": "TODO",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "imgtune": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "packageManager": "pnpm@10.8.0",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  }
}
