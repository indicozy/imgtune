{
  "name": "imgtune",
  "version": "0.1.0",
  "description": "Measures the image waste of live pages per view and viewport, and tunes next/image sizes and quality, checked with SSIMULACRA2",
  "license": "MIT",
  "author": "indicozy",
  "keywords": [
    "images",
    "image-optimization",
    "nextjs",
    "next-image",
    "srcset",
    "avif",
    "webp",
    "ssimulacra2",
    "ssim",
    "performance",
    "lighthouse",
    "core-web-vitals",
    "cli"
  ],
  "homepage": "https://indicozy.github.io/imgtune/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indicozy/imgtune.git"
  },
  "bugs": {
    "url": "https://github.com/indicozy/imgtune/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "imgtune": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "packageManager": "pnpm@10.8.0",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  }
}
